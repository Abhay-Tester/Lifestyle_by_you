rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection health check doc for getDocFromServer test
    match /test/{docId} {
      allow read: if true;
    }

    // Each authenticated user can ONLY read and write their own documents under /users/{userId}
    // Users can never access or mix data with other users
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

